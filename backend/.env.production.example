# Production Environment Variables for N-finder Backend
# Copy to .env and fill in real values. NEVER commit real secrets.

# Required: Comma-separated list of allowed frontend origins (no trailing slashes)
NFINDER_CORS_ORIGINS=https://your-frontend-domain.vercel.app

# Optional: TMDB API Key for movie posters/metadata (server-side only)
# TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Custom port (Railway/Render will override via PORT env var)
# PORT=8000

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO